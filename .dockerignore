# .dockerignore

# Ignore build outputs
**/bin/
**/obj/
**/out/

# Ignore package directories
packages/
**/packages/

# Ignore VS and VS Code files
.vs/
.vscode/
*.user
*.suo
*.sln.docstates

# Ignore logs
**/logs/
*.log

# Ignore temporary files
**/.tmp/
**/tmp/
**/.temp/
**/temp/

# Ignore test results
**/TestResults/
**/*.trx
**/*.coverage

# Ignore NuGet packages
*.nupkg
**/nuget.exe

# Ignore Docker files when building
Dockerfile*
docker-compose*
.dockerignore

# Ignore Git files
.git/
.gitignore
.gitattributes

# Ignore documentation
README.md
**/README.md
**/*.md

# Ignore environment files
.env
.env.*

# Ignore IDE files
**/.idea/
**/jetbrains/

# Ignore node modules if any
**/node_modules/
**/npm-debug.log*

# Ignore Mac OS files
.DS_Store
**/.DS_Store

# Keep important directories structure
!src/